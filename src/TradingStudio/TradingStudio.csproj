<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version><VersionSuffix></VersionSuffix>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.10</RuntimeFrameworkVersion>
    <SelfContained Condition="'$(PublishDir)' != ''">true</SelfContained>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- NU1510: Hosting 是直接依赖 + Serilog传递依赖，保留显式引用 -->
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ctp_flow\**" />
    <Compile Remove="TickData\**" />
    <Content Remove="ctp_flow\**" />
    <Content Remove="TickData\**" />
    <EmbeddedResource Remove="ctp_flow\**" />
    <EmbeddedResource Remove="TickData\**" />
    <None Remove="ctp_flow\**" />
    <None Remove="TickData\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="bars_live.db" />
  </ItemGroup>

  <ItemGroup>
    <!-- C++/CLI Wrapper — 始终用预编译 DLL (C++/CLI 不支持 SelfContained) -->
    <!-- 修改 CTPWrapper 后需先运行 src\CTP\Wrapper\build.bat -->
    <Reference Include="CTPWrapper" HintPath="..\CTP\Wrapper\bin\Release\CTPWrapper.dll" />
    <ProjectReference Include="..\TradingStudio.Core\TradingStudio.Core.csproj" />
    <ProjectReference Include="..\TradingStudio.Data\TradingStudio.Data.csproj" />
    <ProjectReference Include="..\TradingStudio.Engine\TradingStudio.Engine.csproj" />
    <ProjectReference Include="..\TradingStudio.Strategy\TradingStudio.Strategy.csproj" />
    <ProjectReference Include="..\TradingStudio.Mind\TradingStudio.Mind.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="C:\Program Files\dotnet\packs\Microsoft.NETCore.App.Host.win-x64\10.0.10\runtimes\win-x64\native\ijwhost.dll" CopyToPublishDirectory="PreserveNewest" Link="ijwhost.dll" />
    <Content Include="C:\Windows\System32\vcruntime140.dll" CopyToPublishDirectory="PreserveNewest" Link="vcruntime140.dll" />
    <Content Include="C:\Windows\System32\vcruntime140_1.dll" CopyToPublishDirectory="PreserveNewest" Link="vcruntime140_1.dll" />
    <Content Include="C:\Windows\System32\msvcp140.dll" CopyToPublishDirectory="PreserveNewest" Link="msvcp140.dll" />
    <Content Include="..\CTP\SDK\dll\thostmduserapi_se.dll" CopyToPublishDirectory="PreserveNewest" Link="thostmduserapi_se.dll" />
    <Content Include="..\CTP\SDK\dll\thosttraderapi_se.dll" CopyToPublishDirectory="PreserveNewest" Link="thosttraderapi_se.dll" />
    <Content Include="..\..\tools\UnRAR.exe" CopyToPublishDirectory="PreserveNewest" Link="tools\UnRAR.exe" />
    <Content Include="start-collect.bat" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="start-collect.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- 拷贝 CTP 原生 DLL 到输出目录 -->
  <Target Name="CopyCtpNative" AfterTargets="Build">
    <ItemGroup>
      <_CtpDlls Include="..\CTP\Wrapper\bin\Release\CTPWrapper.dll" />
      <_CtpDlls Include="..\CTP\SDK\dll\thostmduserapi_se.dll" />
      <_CtpDlls Include="..\CTP\SDK\dll\thosttraderapi_se.dll" />
      <_CtpDlls Include="C:\Program Files\dotnet\packs\Microsoft.NETCore.App.Host.win-x64\10.0.10\runtimes\win-x64\native\ijwhost.dll" />
      <_CtpDlls Include="C:\Windows\System32\vcruntime140.dll" />
      <_CtpDlls Include="C:\Windows\System32\vcruntime140_1.dll" />
      <_CtpDlls Include="C:\Windows\System32\msvcp140.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_CtpDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
