<Window x:Class="TradingStudio.Terminal.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TradingStudio.Terminal.Views"
        Title="TradingStudio — K线图"
        Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VsBgPrimary}"
        BorderBrush="{StaticResource VsBorder}" BorderThickness="0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 图表主体 -->
        <views:ChartView Grid.Row="0" />

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Background="{StaticResource VsStatusBar}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText, FallbackValue=就绪}"
                           Foreground="White" FontSize="11" VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <TextBlock Text="品种: " Foreground="{StaticResource VsFgMuted}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedProduct.Code, FallbackValue=—}"
                           Foreground="White" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="周期: " Foreground="{StaticResource VsFgMuted}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedFrequency, FallbackValue=—}"
                           Foreground="White" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="Ctrl+D 仪表盘  |  Ctrl+C K线  |  滚轮缩放  |  右键拖拽"
                           Foreground="{StaticResource VsFgMuted}" FontSize="10"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="40,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
