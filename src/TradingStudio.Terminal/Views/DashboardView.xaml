<UserControl x:Class="TradingStudio.Terminal.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource VsBgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/><RowDefinition Height="1*"/><RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 系统健康 -->
        <Border Grid.Row="0" Grid.Column="0" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="系统健康" Foreground="{StaticResource VsFgPrimary}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="● 已连接" Foreground="{StaticResource VsAccentGreen}" FontSize="13" Margin="0,8,0,0"/>
                <TextBlock Text="日盘 09:00-15:00" Foreground="{StaticResource VsFgSecondary}" Margin="0,4,0,0"/>
                <TextBlock Text="运行 3d 2h 15m" Foreground="{StaticResource VsFgSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 风控概览 -->
        <Border Grid.Row="0" Grid.Column="1" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="风控概览" Foreground="{StaticResource VsFgPrimary}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="权益 ¥102,345" Foreground="White" FontSize="16" Margin="0,8,0,0"/>
                <TextBlock Text="保证金 45% · 回撤 -2.1% · 敞口 3 品种" Foreground="{StaticResource VsFgSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 活跃告警 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="活跃告警" Foreground="{StaticResource VsFgPrimary}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="⚠ 14:32 rb2608 滑点偏高 (2.3 tick)" Foreground="{StaticResource VsAccentYellow}" Margin="0,6,0,0"/>
                <TextBlock Text="⚠ 14:28 CTP 重连 #2" Foreground="{StaticResource VsAccentYellow}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 策略状态 + 最近成交 -->
        <Border Grid.Row="2" Grid.Column="0" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="策略状态" Foreground="{StaticResource VsFgPrimary}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="▶ MA趋势 · 权益 51,234 · 持仓 2" Foreground="{StaticResource VsAccentGreen}" Margin="0,6,0,0"/>
                <TextBlock Text="■ 网格 · 暂停 · 权益 48,901" Foreground="{StaticResource VsAccentRed}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="最近成交" Foreground="{StaticResource VsFgPrimary}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="15:00 cu2607 多开 2手 @68500 +1200" Foreground="{StaticResource VsAccentGreen}" Margin="0,6,0,0"/>
                <TextBlock Text="14:55 rb2608 平仓 1手 @3520 +350" Foreground="{StaticResource VsAccentGreen}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
