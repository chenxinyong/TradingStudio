<UserControl x:Class="TradingStudio.Terminal.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource VsBgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/><RowDefinition Height="1*"/><RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 系统健康 -->
        <Border Grid.Row="0" Grid.Column="0" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="系统健康" Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StatusText}" FontSize="16" Margin="0,4,0,0">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding StatusColor, FallbackValue=#4EC9B0}" />
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,4,0,0">
                    <Run Text="Tick "/><Run Text="{Binding TickCount, FallbackValue=0}"/><Run Text=" · 品种 "/>
                    <Run Text="{Binding ConnectedInstruments, FallbackValue=0}"/>
                </TextBlock>
                <TextBlock Text="{Binding Session, FallbackValue=休市}" Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 风控概览 -->
        <Border Grid.Row="0" Grid.Column="1" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="风控概览" Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,0,0,8"/>
                <TextBlock FontSize="18" FontWeight="Bold" Margin="0,4,0,0">
                    <Run Text="¥" Foreground="{StaticResource VsFgMuted}"/><Run Text="{Binding TotalEquity, FallbackValue=102345, StringFormat=N0}" Foreground="White"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,4,0,0">
                    <Run Text="保证金 "/><Run Text="{Binding MarginPct, FallbackValue=45, StringFormat=F1}"/><Run Text="% · 持仓 "/>
                    <Run Text="{Binding PositionCount, FallbackValue=3}"/><Run Text=" 手"/>
                </TextBlock>
                <TextBlock Text="可用 {Binding Cash, FallbackValue=55000, StringFormat=¥#,##0}" Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 活跃告警 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="活跃告警" Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding RecentAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" Margin="0,2,0,0">
                                <Run Text="⚠" Foreground="{StaticResource VsAccentYellow}"/>
                                <Run Text="{Binding Type, Mode=OneWay}" Foreground="{StaticResource VsFgPrimary}"/>
                                <Run Text=" " Foreground="{StaticResource VsFgMuted}"/>
                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource VsFgMuted}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="暂无告警" Foreground="{StaticResource VsFgMuted}" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding RecentAlerts.Count, Converter={StaticResource ZeroToVisible}}" />
            </StackPanel>
        </Border>

        <!-- 策略状态 -->
        <Border Grid.Row="2" Grid.Column="0" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="策略状态" Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Strategies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" Margin="0,2,0,0">
                                <Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource VsAccentGreen}"/>
                                <Run Text=" "/><Run Text="{Binding StrategyId, Mode=OneWay}" Foreground="{StaticResource VsFgPrimary}"/>
                                <Run Text=" · "/><Run Text="¥" Foreground="{StaticResource VsFgMuted}"/>
                                <Run Text="{Binding CurrentEquity, Mode=OneWay, StringFormat=N0}" Foreground="{StaticResource VsFgSecondary}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="无运行策略" Foreground="{StaticResource VsFgMuted}" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding Strategies.Count, Converter={StaticResource ZeroToVisible}}" />
            </StackPanel>
        </Border>

        <!-- 最近成交 -->
        <Border Grid.Row="2" Grid.Column="1" Margin="4" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="最近成交" Foreground="{StaticResource VsFgSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding RecentOrders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource VsFgSecondary}">
                                <Run Text="{Binding Type, Mode=OneWay}"/><Run Text=" "/>
                                <Run Text="{Binding InstrumentId, Mode=OneWay}" Foreground="{StaticResource VsFgPrimary}"/>
                                <Run Text=" "/><Run Text="{Binding Direction, Mode=OneWay}"/>
                                <Run Text=" "/><Run Text="{Binding Quantity, Mode=OneWay}"/><Run Text="手"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="暂无成交" Foreground="{StaticResource VsFgMuted}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
