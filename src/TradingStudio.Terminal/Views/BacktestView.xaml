<UserControl x:Class="TradingStudio.Terminal.Views.BacktestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource VsBgPrimary}" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── 左侧: 配置表单 ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="回测配置" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource VsFgPrimary}" Margin="0,0,0,12" />

                <TextBlock Text="策略类型" Foreground="{StaticResource VsFgSecondary}" FontSize="11" Margin="0,4,0,2"/>
                <ComboBox ItemsSource="{Binding StrategyTypes}" SelectedItem="{Binding SelectedStrategy}"
                          Background="{StaticResource VsBgSecondary}" Foreground="{StaticResource VsFgPrimary}"
                          Height="28" FontSize="12" />

                <TextBlock Text="品种代码" Foreground="{StaticResource VsFgSecondary}" FontSize="11" Margin="0,8,0,2"/>
                <TextBox Text="{Binding InstrumentId}" Background="{StaticResource VsBgSecondary}"
                         Foreground="{StaticResource VsFgPrimary}" Height="28" FontSize="12" />

                <TextBlock Text="K线周期(分钟)" Foreground="{StaticResource VsFgSecondary}" FontSize="11" Margin="0,8,0,2"/>
                <TextBox Text="{Binding BarPeriod}" Background="{StaticResource VsBgSecondary}"
                         Foreground="{StaticResource VsFgPrimary}" Height="28" FontSize="12" />

                <TextBlock Text="初始资金" Foreground="{StaticResource VsFgSecondary}" FontSize="11" Margin="0,8,0,2"/>
                <TextBox Text="{Binding Capital}" Background="{StaticResource VsBgSecondary}"
                         Foreground="{StaticResource VsFgPrimary}" Height="28" FontSize="12" />

                <TextBlock Text="策略参数 (JSON)" Foreground="{StaticResource VsFgSecondary}" FontSize="11" Margin="0,8,0,2"/>
                <TextBox Text="{Binding Parameters}" Background="{StaticResource VsBgSecondary}"
                         Foreground="{StaticResource VsFgPrimary}" Height="120" FontSize="11"
                         AcceptsReturn="True" FontFamily="Consolas"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                <Button Content="▶ 执行回测" Command="{Binding RunBacktestCommand}" Height="36"
                        Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold"
                        Background="{StaticResource VsAccentBlue}" Foreground="White"
                        BorderThickness="0" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />

                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource VsFgSecondary}"
                           FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── 右侧: 结果面板 ── -->
        <Border Grid.Column="1" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="回测结果" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource VsFgPrimary}" Margin="0,0,0,12" />

                <!-- 关键指标 Grid -->
                <Grid Margin="0,0,0,16">
                    <Grid.Resources>
                        <Style TargetType="TextBlock" x:Key="KPILabel">
                            <Setter Property="Foreground" Value="{StaticResource VsFgSecondary}"/>
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                        <Style TargetType="TextBlock" x:Key="KPIValue">
                            <Setter Property="Foreground" Value="{StaticResource VsFgPrimary}"/>
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,4">
                        <TextBlock Text="总盈亏" Style="{StaticResource KPILabel}" />
                        <TextBlock Text="{Binding ResultPnL}" Style="{StaticResource KPIValue}"
                                   Foreground="{StaticResource VsAccentGreen}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                        <TextBlock Text="交易笔数" Style="{StaticResource KPILabel}" />
                        <TextBlock Text="{Binding ResultTrades}" Style="{StaticResource KPIValue}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4">
                        <TextBlock Text="胜率" Style="{StaticResource KPILabel}" />
                        <TextBlock Text="{Binding ResultWinRate}" Style="{StaticResource KPIValue}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                        <TextBlock Text="盈亏比" Style="{StaticResource KPILabel}" />
                        <TextBlock Text="{Binding ResultPLR}" Style="{StaticResource KPIValue}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4">
                        <TextBlock Text="最大回撤" Style="{StaticResource KPILabel}" />
                        <TextBlock Text="{Binding ResultDD}" Style="{StaticResource KPIValue}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                        <TextBlock Text="Sharpe" Style="{StaticResource KPILabel}" />
                        <TextBlock Text="{Binding ResultSharpe}" Style="{StaticResource KPIValue}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,4">
                        <TextBlock Text="年化收益" Style="{StaticResource KPILabel}" />
                        <TextBlock Text="{Binding ResultAnnual}" Style="{StaticResource KPIValue}" />
                    </StackPanel>
                </Grid>

                <!-- 结果说明 -->
                <TextBlock Text="结果实时显示 — 从引擎 live 模式 REST API 获取"
                           Foreground="{StaticResource VsFgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="查看完整报告: GET /api/backtest/{id}/report"
                           Foreground="{StaticResource VsFgMuted}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
