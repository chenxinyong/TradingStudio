<UserControl x:Class="TradingStudio.Terminal.Views.ReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">
    <Grid Background="{StaticResource VsBgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- ── 控制栏 ── -->
        <Border Grid.Row="0" Background="{StaticResource VsBgTertiary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel>
                <TextBlock Text="品种" Foreground="{StaticResource VsFgMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding InstrumentId}" Width="70" Height="24" FontSize="12"
                         Background="{StaticResource VsBgSecondary}" Foreground="{StaticResource VsFgPrimary}" />

                <TextBlock Text="起" Foreground="{StaticResource VsFgMuted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Text="{Binding StartDate}" Width="90" Height="24" FontSize="12"
                         Background="{StaticResource VsBgSecondary}" Foreground="{StaticResource VsFgPrimary}" />

                <TextBlock Text="止" Foreground="{StaticResource VsFgMuted}" FontSize="11" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBox Text="{Binding EndDate}" Width="90" Height="24" FontSize="12"
                         Background="{StaticResource VsBgSecondary}" Foreground="{StaticResource VsFgPrimary}" />

                <Button Content="加载" Command="{Binding LoadCommand}" Height="24" Margin="8,0,4,0"
                        Background="{StaticResource VsBgTertiary}" Foreground="{StaticResource VsFgPrimary}" FontSize="11"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>

                <Button Content="▶" Command="{Binding PlayPauseCommand}" Height="28" Width="36"
                        Background="{StaticResource VsAccentBlue}" Foreground="White" FontSize="14" Margin="4,0"/>
                <Button Content="⏭" Command="{Binding StepCommand}" Height="28" Width="36"
                        Background="{StaticResource VsBgTertiary}" Foreground="{StaticResource VsFgPrimary}" FontSize="14" Margin="4,0"/>
                <Button Content="⟳" Command="{Binding ResetCommand}" Height="28" Width="36"
                        Background="{StaticResource VsBgTertiary}" Foreground="{StaticResource VsFgPrimary}" FontSize="14" Margin="4,0"/>

                <TextBlock Text="速度" Foreground="{StaticResource VsFgMuted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding Speed}"
                          Width="60" Height="24" FontSize="12"
                          Background="{StaticResource VsBgSecondary}" Foreground="{StaticResource VsFgPrimary}" />

                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource VsFgSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
            </WrapPanel>
        </Border>

        <!-- ── K线图 ── -->
        <oxy:PlotView Grid.Row="1" Model="{Binding KLineModel}" />

        <!-- ── 进度条 + 当前Bar信息 ── -->
        <Border Grid.Row="2" Background="{StaticResource VsBgSecondary}" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentBarInfo}"
                           Foreground="{StaticResource VsFgPrimary}" FontSize="11" Margin="0,0,12,0"/>
                <ProgressBar Grid.Column="1" Value="{Binding Progress}" Maximum="100" Height="8"
                             Foreground="{StaticResource VsAccentBlue}" Background="{StaticResource VsBgTertiary}"/>
                <TextBlock Grid.Column="2" Text="{Binding Progress, StringFormat={}{0}%}"
                           Foreground="{StaticResource VsFgSecondary}" FontSize="11" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── 权益曲线 ── -->
        <oxy:PlotView Grid.Row="3" Model="{Binding EquityModel}" />
    </Grid>
</UserControl>
