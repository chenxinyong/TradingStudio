<UserControl x:Class="TradingStudio.Terminal.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">
    <UserControl.Resources>
        <!-- 品种列表项模板 -->
        <DataTemplate x:Key="ProductItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="40"
                           Foreground="{StaticResource VsFgPrimary}" />
                <TextBlock Text=" " Foreground="{StaticResource VsFgMuted}" />
                <TextBlock Text="{Binding BarCount, StringFormat={}{0:N0} bars}"
                           Foreground="{StaticResource VsFgSecondary}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.5*" />
        </Grid.RowDefinitions>

        <!-- ── 工具栏 ── -->
        <Border Grid.Row="0" Background="{StaticResource VsBgTertiary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <!-- 品种选择 -->
                <TextBlock Text="品种" Foreground="{StaticResource VsFgMuted}"
                           FontSize="11" VerticalAlignment="Center" Margin="4,0,4,0" />
                <ComboBox Width="100" Height="24" FontSize="12"
                          ItemsSource="{Binding AvailableProducts}"
                          SelectedItem="{Binding SelectedProduct}"
                          ItemTemplate="{StaticResource ProductItemTemplate}"
                          Background="{StaticResource VsBgSecondary}"
                          Foreground="{StaticResource VsFgPrimary}" />

                <TextBlock Text="周期" Foreground="{StaticResource VsFgMuted}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,4,0" />
                <ComboBox Width="70" Height="24" FontSize="12"
                          ItemsSource="{Binding AvailableFrequencies}"
                          SelectedItem="{Binding SelectedFrequency}"
                          Background="{StaticResource VsBgSecondary}"
                          Foreground="{StaticResource VsFgPrimary}" />

                <Button Content="⟳ 刷新" Command="{Binding ReloadCommand}" Margin="12,0,4,0" Height="24"
                        Background="{StaticResource VsBgTertiary}" Foreground="{StaticResource VsFgPrimary}"
                        BorderBrush="{StaticResource VsBorder}" FontSize="11" />

                <!-- 分隔 -->
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0" />

                <!-- 指标开关 -->
                <CheckBox IsChecked="{Binding ShowMA}" Content="MA"
                          Foreground="{StaticResource VsFgSecondary}" Margin="4,0" FontSize="11"
                          VerticalAlignment="Center" />
                <CheckBox IsChecked="{Binding ShowBoll}" Content="BOLL"
                          Foreground="{StaticResource VsFgSecondary}" Margin="4,0" FontSize="11"
                          VerticalAlignment="Center" />
                <CheckBox IsChecked="{Binding ShowMACD}" Content="MACD"
                          Foreground="{StaticResource VsFgSecondary}" Margin="4,0" FontSize="11"
                          VerticalAlignment="Center" />
                <CheckBox IsChecked="{Binding ShowRSI}" Content="RSI"
                          Foreground="{StaticResource VsFgSecondary}" Margin="4,0" FontSize="11"
                          VerticalAlignment="Center" />

                <Button Content="重置" Command="{Binding ResetViewCommand}" Margin="8,0,4,0" Height="24"
                        Background="{StaticResource VsBgTertiary}" Foreground="{StaticResource VsFgPrimary}"
                        BorderBrush="{StaticResource VsBorder}" FontSize="11" />

                <!-- 状态文本 -->
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource VsFgMuted}"
                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
            </WrapPanel>
        </Border>

        <!-- ── K线主图 ── -->
        <oxy:PlotView Grid.Row="1" Model="{Binding KLineModel}" />

        <!-- Splitter → 成交量 -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource VsBorderLight}" />
        <oxy:PlotView Grid.Row="3" Model="{Binding VolumeModel}" />

        <!-- Splitter → MACD -->
        <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource VsBorderLight}" />
        <oxy:PlotView Grid.Row="5" Model="{Binding MacdModel}" />

        <!-- Splitter → RSI -->
        <GridSplitter Grid.Row="6" Height="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource VsBorderLight}" />
        <oxy:PlotView Grid.Row="7" Model="{Binding RsiModel}" />
    </Grid>
</UserControl>
