<UserControl x:Class="TradingStudio.Terminal.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource VsBgPrimary}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="IconText" Text="📋" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock x:Name="TitleText" Text="功能开发中" FontSize="18"
                       Foreground="{StaticResource VsFgPrimary}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="DescText" Text="" FontSize="13"
                       Foreground="{StaticResource VsFgMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
