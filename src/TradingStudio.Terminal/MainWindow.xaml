<Window x:Class="TradingStudio.Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:converters="clr-namespace:TradingStudio.Terminal.Converters"
        Title="TradingStudio.Terminal"
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VsBgPrimary}">

    <Window.Resources>
        <converters:RunningToIconConverter x:Key="RunningToIcon" />
        <converters:RunningToTextConverter x:Key="RunningToText" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VsBgTertiary}" />
            <Setter Property="Foreground" Value="{StaticResource VsFgPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource VsBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource VsBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource VsFgSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource VsFgMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <!-- 侧栏导航按钮 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VsFgMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource VsBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════
         VS Code 布局: 侧栏 + 主区 + 状态栏
         ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource VsBgSecondary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                <Button Style="{StaticResource NavButton}" Content="📊"
                        ToolTip="仪表盘 (Ctrl+1)" Click="NavDashboard_Click" />
                <Button Style="{StaticResource NavButton}" Content="📈"
                        ToolTip="行情 (Ctrl+2)" Click="NavChart_Click" />
                <Button Style="{StaticResource NavButton}" Content="📋"
                        ToolTip="策略 (Ctrl+3)" Click="NavStrategies_Click" />
                <Button Style="{StaticResource NavButton}" Content="📜"
                        ToolTip="订单 (Ctrl+4)" Click="NavOrders_Click" />
                <Separator Background="{StaticResource VsBorder}" Height="1" Margin="8,4" />
                <Button Style="{StaticResource NavButton}" Content="⚙"
                        ToolTip="日志 (Ctrl+5)" Click="NavLogs_Click" />
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.5*" />
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Border Grid.Row="0" Background="{StaticResource VsBgTertiary}"
                    BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                <Grid>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding ToggleRealtimeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IsRunning, Converter={StaticResource RunningToIcon}}" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{Binding IsRunning, Converter={StaticResource RunningToText}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}"
                                Content="重置" Command="{Binding ResetViewCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <CheckBox Style="{StaticResource ToggleCheck}"
                                  IsChecked="{Binding ShowMA}" Content="MA(5,20,60)" />
                        <CheckBox Style="{StaticResource ToggleCheck}"
                                  IsChecked="{Binding ShowBoll}" Content="BOLL(20,2)" />
                        <CheckBox Style="{StaticResource ToggleCheck}"
                                  IsChecked="{Binding ShowMACD}" Content="MACD" />
                        <CheckBox Style="{StaticResource ToggleCheck}"
                                  IsChecked="{Binding ShowRSI}" Content="RSI(14)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- K 线主图 -->
            <oxy:PlotView Grid.Row="1" Model="{Binding KLineModel}" />
            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource VsBorderLight}" />
            <!-- 成交量 -->
            <oxy:PlotView Grid.Row="3" Model="{Binding VolumeModel}" />
            <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource VsBorderLight}" />
            <!-- MACD -->
            <oxy:PlotView Grid.Row="5" Model="{Binding MacdModel}" />
            <GridSplitter Grid.Row="6" Height="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource VsBorderLight}" />
            <!-- RSI -->
            <oxy:PlotView Grid.Row="7" Model="{Binding RsiModel}" />
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource VsStatusBar}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,1,0,0" Padding="8,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource StatusText}" Text="TradingStudio.Terminal" />
                <TextBlock Style="{StaticResource StatusText}" Text="|" />
                <TextBlock Style="{StaticResource StatusText}" Foreground="{StaticResource VsFgSecondary}"
                           Text="K 线 Demo · VS Code 风格" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
