<Window x:Class="TradingStudio.Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TradingStudio.Terminal" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip"
        BorderBrush="{StaticResource VsBorder}" BorderThickness="1"
        Background="{StaticResource VsBgPrimary}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 侧栏导航按钮 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VsFgMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource VsBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窗口控制按钮 -->
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VsFgPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource VsBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusItem" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource VsFgSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>
    </Window.Resources>

    <!-- ═══ 主布局 ═══ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />  <!-- 标题栏 -->
            <RowDefinition Height="*" />   <!-- 内容区 -->
            <RowDefinition Height="24" />  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ── 标题栏 ── -->
        <Border Grid.Row="0" Background="{StaticResource VsBgTertiary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,0,1"
                MouseDown="TitleBar_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="TradingStudio" FontSize="13" Foreground="{StaticResource VsFgPrimary}"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="Terminal" FontSize="13" Foreground="{StaticResource VsFgMuted}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource WinButton}" Content="─" ToolTip="最小化" Click="Minimize_Click" />
                    <Button Style="{StaticResource WinButton}" Content="□" ToolTip="最大化" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="✕" ToolTip="关闭" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 内容区 ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource VsBgSecondary}"
                    BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                    <Button Style="{StaticResource NavButton}" Content="📊" ToolTip="仪表盘 (Ctrl+1)" Click="NavDashboard_Click" />
                    <Button Style="{StaticResource NavButton}" Content="📈" ToolTip="行情图表 (Ctrl+2)" Click="NavChart_Click" />
                    <Button Style="{StaticResource NavButton}" Content="📋" ToolTip="策略管理 (Ctrl+3)" Click="NavStrategies_Click" />
                    <Button Style="{StaticResource NavButton}" Content="📜" ToolTip="订单监控 (Ctrl+4)" Click="NavOrders_Click" />
                    <Separator Background="{StaticResource VsBorderLight}" Height="1" Margin="8,4" />
                    <Button Style="{StaticResource NavButton}" Content="⚙" ToolTip="日志 (Ctrl+5)" Click="NavLogs_Click" />
                </StackPanel>
            </Border>

            <!-- 主内容区 -->
            <ContentControl Grid.Column="1" x:Name="MainContent" />
        </Grid>

        <!-- ── 状态栏 (绑定 DashboardViewModel) ── -->
        <Border Grid.Row="2" Background="{StaticResource VsStatusBar}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,1,0,0" Padding="8,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding StatusColor, FallbackValue=#4EC9B0}" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText, FallbackValue=● 已连接}" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource StatusItem}" Text="{Binding Session, StringFormat='📅 {0}', FallbackValue='📅 休市'}" />
                    <TextBlock Style="{StaticResource StatusItem}">
                        <Run Text="💰 ¥"/><Run Text="{Binding TotalEquity, StringFormat=N0, FallbackValue=102345}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource StatusItem}">
                        <Run Text="品种 "/><Run Text="{Binding ConnectedInstruments, FallbackValue=45}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource StatusItem}" Foreground="{StaticResource VsAccentYellow}">
                        <Run Text="⚠ "/><Run Text="{Binding RecentAlerts.Count, FallbackValue=3}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Margin="0,0,12,0">
                    <TextBlock Text="Ctrl+1~5 切换视图" Foreground="{StaticResource VsFgMuted}" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
