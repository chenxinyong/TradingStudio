<Window x:Class="TradingStudio.Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TradingStudio.Terminal" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip"
        BorderBrush="{StaticResource VsBorder}" BorderThickness="1"
        Background="{StaticResource VsBgPrimary}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 侧栏导航按钮 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VsFgMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource VsBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窗口控制按钮 -->
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VsFgPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource VsBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单项样式 -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource VsFgSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Header}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource VsBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusItem" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource VsFgSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>
    </Window.Resources>

    <!-- ═══ 主布局 ═══ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />  <!-- 标题栏 -->
            <RowDefinition Height="28" />  <!-- 菜单+命令栏 -->
            <RowDefinition Height="*" />   <!-- 内容区 -->
            <RowDefinition Height="24" />  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ── 标题栏 ── -->
        <Border Grid.Row="0" Background="{StaticResource VsBgTertiary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,0,1"
                MouseDown="TitleBar_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="TradingStudio" FontSize="13" Foreground="{StaticResource VsFgPrimary}"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="Terminal" FontSize="13" Foreground="{StaticResource VsFgMuted}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource WinButton}" Content="─" ToolTip="最小化" Click="Minimize_Click" />
                    <Button Style="{StaticResource WinButton}" Content="□" ToolTip="最大化" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="✕" ToolTip="关闭" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 菜单+命令栏 (同行) ── -->
        <Border Grid.Row="1" Background="{StaticResource VsBgTertiary}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <MenuItem Header="文件(_F)" FontSize="12" Padding="6,2" />
                    <MenuItem Header="编辑(_E)" FontSize="12" Padding="6,2" />
                    <MenuItem Header="视图(_V)" FontSize="12" Padding="6,2" />
                    <MenuItem Header="工具(_T)" FontSize="12" Padding="6,2" />
                    <MenuItem Header="帮助(_H)" FontSize="12" Padding="6,2" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="搜索命令 (Ctrl+Shift+P)" FontSize="12"
                               Foreground="{StaticResource VsFgMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 内容区 ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />       <!-- 导航 -->
                <ColumnDefinition Width="220" />      <!-- 左侧面板 -->
                <ColumnDefinition Width="Auto" MinWidth="4" />
                <ColumnDefinition Width="*" />        <!-- 主内容 -->
                <ColumnDefinition Width="Auto" MinWidth="4" />
                <ColumnDefinition Width="280" />      <!-- 右侧面板 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource VsBgSecondary}"
                    BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,8,0,0">
                        <Button Style="{StaticResource NavButton}" Content="📊" ToolTip="仪表盘 (Ctrl+1)" Click="NavDashboard_Click" />
                        <Button Style="{StaticResource NavButton}" Content="📈" ToolTip="行情图表 (Ctrl+2)" Click="NavChart_Click" />
                        <Button Style="{StaticResource NavButton}" Content="📋" ToolTip="策略管理 (Ctrl+3)" Click="NavStrategies_Click" />
                        <Button Style="{StaticResource NavButton}" Content="📜" ToolTip="订单监控 (Ctrl+4)" Click="NavOrders_Click" />
                        <Separator Background="{StaticResource VsBorderLight}" Height="1" Margin="8,4" />
                        <Button Style="{StaticResource NavButton}" Content="⚙" ToolTip="日志 (Ctrl+5)" Click="NavLogs_Click" />
                    </StackPanel>
                    <Button Grid.Row="2" Style="{StaticResource NavButton}" Content="⚡"
                            ToolTip="管理" Margin="0,0,0,8" Click="NavAdmin_Click" />
                </Grid>
            </Border>

            <!-- 左侧面板 (资源树/品种列表/策略树) -->
            <Border Grid.Column="1" Background="{StaticResource VsBgSecondary}"
                    BorderBrush="{StaticResource VsBorder}" BorderThickness="0,0,1,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="资源管理器" FontSize="11" Foreground="{StaticResource VsFgSecondary}"
                               FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="📂 品种列表" FontSize="12" Foreground="{StaticResource VsFgPrimary}" />
                    <TextBlock Text="  rb2608" FontSize="12" Foreground="{StaticResource VsFgMuted}" Margin="8,2,0,0"/>
                    <TextBlock Text="  cu2607" FontSize="12" Foreground="{StaticResource VsFgMuted}" Margin="8,2,0,0"/>
                    <TextBlock Text="  ag2608" FontSize="12" Foreground="{StaticResource VsFgMuted}" Margin="8,2,0,0"/>
                    <TextBlock Text="📂 策略列表" FontSize="12" Foreground="{StaticResource VsFgPrimary}" Margin="0,12,0,0"/>
                    <TextBlock Text="  MA趋势" FontSize="12" Foreground="{StaticResource VsFgMuted}" Margin="8,2,0,0"/>
                    <TextBlock Text="  网格策略" FontSize="12" Foreground="{StaticResource VsFgMuted}" Margin="8,2,0,0"/>
                    <TextBlock Text="📂 服务器" FontSize="12" Foreground="{StaticResource VsFgPrimary}" Margin="0,12,0,0"/>
                    <TextBlock Text="  localhost:5199" FontSize="12" Foreground="{StaticResource VsFgMuted}" Margin="8,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource VsBorderLight}" />

            <!-- 主内容区 (多文档标签) -->
            <TabControl Grid.Column="3" x:Name="MainTabs" Background="{StaticResource VsBgPrimary}"
                        BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="{StaticResource VsBgTertiary}" />
                        <Setter Property="Foreground" Value="{StaticResource VsFgSecondary}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{StaticResource VsAccentBlue}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{TemplateBinding Header}"
                                                              VerticalAlignment="Center" />
                                            <Button Content="✕" FontSize="10" Cursor="Hand"
                                                    Foreground="{StaticResource VsFgMuted}" Background="Transparent"
                                                    BorderThickness="0" Margin="8,0,0,0" Padding="2,0"
                                                    Click="CloseTab_Click" Tag="{TemplateBinding Name}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource VsBgPrimary}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource VsBgHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
            </TabControl>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="4" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource VsBorderLight}" />

            <!-- 右侧面板 (详情/属性) -->
            <Border Grid.Column="5" Background="{StaticResource VsBgSecondary}"
                    BorderBrush="{StaticResource VsBorder}" BorderThickness="1,0,0,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="详情" FontSize="11" Foreground="{StaticResource VsFgSecondary}"
                               FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="选择品种或策略查看详情" FontSize="12"
                               Foreground="{StaticResource VsFgMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── 状态栏 (绑定 DashboardViewModel) ── -->
        <Border Grid.Row="3" Background="{StaticResource VsStatusBar}"
                BorderBrush="{StaticResource VsBorder}" BorderThickness="0,1,0,0" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding StatusColor, FallbackValue=#4EC9B0}" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText, FallbackValue=● 已连接}" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource StatusItem}" Text="{Binding Session, StringFormat='📅 {0}', FallbackValue='📅 休市'}" />
                    <TextBlock Style="{StaticResource StatusItem}"><Run Text="💰 ¥"/><Run Text="{Binding TotalEquity, StringFormat=N0, FallbackValue=102345}"/></TextBlock>
                    <TextBlock Style="{StaticResource StatusItem}"><Run Text="品种 "/><Run Text="{Binding ConnectedInstruments, Mode=OneWay, FallbackValue=45}"/></TextBlock>
                    <TextBlock Style="{StaticResource StatusItem}" Foreground="{StaticResource VsAccentYellow}"><Run Text="⚠ "/><Run Text="{Binding RecentAlerts.Count, Mode=OneWay, FallbackValue=3}"/></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+1~5" Foreground="{StaticResource VsFgMuted}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
